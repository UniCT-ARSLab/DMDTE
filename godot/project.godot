config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Digital Twin Framework"
run/main_scene="uid://cdxw7cj4krr61"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Globals="*res://autoloads/Globals.gd"
CmdArgs="*res://scripts/cmdargs.gd"
LoaderScript="*res://autoloads/LoaderScript.gd"
PhantomCameraManager="*uid://duq6jhf6unyis"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[editor_plugins]

enabled=PackedStringArray("res://addons/dmdte/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

